#include <SoftwareSerial.h>

SoftwareSerial BTSerial(2, 3);

// Pin Definitions
const int soilPin = A6;       // Capacitive Soil Moisture Sensor v2
const int lightPin = A7;      // KY-018 Photoresistor

void setup() {
    Serial.begin(9600);       // Debugging via USB
    BTSerial.begin(9600);     // Bluetooth Communication

    pinMode(soilPin, INPUT);
    pinMode(lightPin, INPUT);

    Serial.println("AeroStem System Online...");
}

void loop() {
    // 1. Read Sensors
    int rawSoil = analogRead(soilPin);
    int rawLight = analogRead(lightPin);

    int soilPercent = map(rawSoil, 950, 245, 0, 100);
    soilPercent = constrain(soilPercent, 0, 100);

    int lightPercent = map(rawLight, 1023, 0, 0, 100);
    lightPercent = constrain(lightPercent, 0, 100);

    // 2. Send Data to App Inventor
    // We use a String object to combine them to ensure they send together
    String dataPacket = String(soilPercent) + "|" + String(lightPercent);

    // 3. Send Data
    BTSerial.println(dataPacket);  // println adds a new line (\n) which helps us separate packets

    // 4. Debugging
    Serial.println(dataPacket);

    delay(1000);
}
